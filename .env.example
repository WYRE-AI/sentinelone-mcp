# Bind address. With a real CONDUIT_S2S_SECRET, an unset MCP_HTTP_HOST stays
# 0.0.0.0 so container deploys keep the historical bind. The image and Compose
# set 0.0.0.0 inside the container and publish the host port on 127.0.0.1.
# MCP_ALLOW_INSECURE_DEV=1 ignores a loopback value and binds 127.0.0.1 only;
# a non-loopback value refuses to start.
# MCP_HTTP_HOST=127.0.0.1

# Public listen port.
PORT=8080

# Required to start the HTTP server. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, replace-with-a-real-secret, and the other example values).
# Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1. A non-loopback MCP_HTTP_HOST refuses to start.
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Fastify log level: debug, info, warn, error
LOG_LEVEL=info

# Gateway mode does not read SentinelOne credentials from the environment.
# Do not put PURPLEMCP_CONSOLE_TOKEN or PURPLEMCP_CONSOLE_BASE_URL here for
# the Compose service. Each /mcp request must send X-S1-API-Token and
# X-S1-Console-URL (legacy x-purplemcp-token / x-purplemcp-base-url still
# accepted).
